{
  "manifest_version": 3,
  "name": "AniWorld → AniList Tracker",
  "version": "1.6.0",
  "description": "Trackt automatisch gesehene Episoden von AniWorld auf AniList und verlinkt AniList-Seiten zu AniWorld",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://aniworld.to/*",
    "https://anilist.co/*",
    "https://graphql.anilist.co/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://aniworld.to/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://anilist.co/*"
      ],
      "js": [
        "anilist_content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "AniListSync@hizombry.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "websiteActivity"
        ]
      }
    }
  }
}