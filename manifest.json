{
  "manifest_version": 3,
  "name": "AniWorld → AniList Tracker",
  "version": "1.3.13",
  "description": "Trackt automatisch gesehene Episoden von AniWorld auf AniList",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://aniworld.to/*",
    "https://graphql.anilist.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://aniworld.to/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}